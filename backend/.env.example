# Copy to backend/.env for local development. NEVER commit the real .env file.
# In production set these as environment variables on your host instead.

NODE_ENV=development
PORT=3000

# MongoDB Atlas -> Connect -> Drivers (the database name is added in code)
MONGODB_CONNECTION_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary dashboard -> API Keys (used for trade screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave EMPTY when Vercel proxies /api requests to this backend.
# Only set this if browser requests call the API directly from another origin.
CORS_ORIGIN=

# Email verification codes via Brevo's HTTPS API (Render's free tier blocks SMTP).
# Brevo -> SMTP & API -> API Keys. MAIL_FROM_EMAIL must be a verified sender in Brevo (Senders & IP).
# Leave BREVO_API_KEY empty in local dev and the code is printed in the server console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TradeCommit

# Google sign-in (OAuth Web client ID, e.g. 1234-abc.apps.googleusercontent.com). Leave empty to hide the button.
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=
GEMINI_API_KEY_NAME=
GEMINI_API_PROJECT_NAME=
GEMINI_PROJECT_NUMBER=

# AI mentor limits (all optional; these are the defaults). They stretch Gemini's shared free-tier quota across many traders.
# A week's first review unlocks after this many trades (a finished week unlocks with 1):
AI_REVIEW_FIRST_TRADES=5
# A refreshed review unlocks after this many new trades (or after the strategy/plans are rewritten):
AI_REVIEW_STEP_TRADES=5
# Reviews one trader can generate per rolling 24 hours / 7 days:
AI_REVIEW_PER_DAY=1
AI_REVIEW_PER_WEEK=3
# Total generations for all traders per Pacific day. Set this BELOW your real Gemini requests-per-day limit
# (check Google AI Studio -> your key's rate limits; the numbers change over time):
AI_DAILY_BUDGET=20
# Queue in front of Gemini: parallel calls, milliseconds between call starts (6000 = about 10 a minute),
# how long a request may wait in line, and how many may wait at all:
AI_MAX_CONCURRENT=2
AI_MIN_INTERVAL_MS=6000
AI_MAX_QUEUE_WAIT_MS=60000
AI_MAX_QUEUE=15

# Date-range reviews (swing traders): the longest range one review may cover, in days
AI_RANGE_MAX_DAYS=366
