# Copy to backend/.env for local development. NEVER commit the real .env file.
# In production set these as environment variables on your host instead.

NODE_ENV=development
PORT=3000

# MongoDB Atlas -> Connect -> Drivers (the database name is added in code)
MONGODB_CONNECTION_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary dashboard -> API Keys (used for trade screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave EMPTY when Vercel proxies /api requests to this backend.
# Only set this if browser requests call the API directly from another origin.
CORS_ORIGIN=

# Email verification codes via Brevo's HTTPS API (Render's free tier blocks SMTP).
# Brevo -> SMTP & API -> API Keys. MAIL_FROM_EMAIL must be a verified sender in Brevo (Senders & IP).
# Leave BREVO_API_KEY empty in local dev and the code is printed in the server console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TradeCommit

# Google sign-in (OAuth Web client ID, e.g. 1234-abc.apps.googleusercontent.com). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
